{
  "manifest_version": 3,
  "name": "HStora → Z2U Listing Assistant",
  "version": "1.1.0",
  "description": "Creates Z2U Twitter/X account offers from HStora Watcher.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://hstora.itspanel.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.z2u.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "HStora Z2U Assistant", "default_popup": "options.html"},
  "content_scripts": [
    {
      "matches": ["https://hstora.itspanel.com/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["dashboard.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.z2u.com/*"],
      "js": ["z2u.js"],
      "run_at": "document_idle"
    }
  ]
}
